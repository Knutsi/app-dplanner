/* Writer — theme stylesheet (one template, substituted per theme).
 *
 * A string.Template. Placeholders are a dollar sign followed by a token name from
 * writer.theme.tokens; use the braced form wherever a letter follows the name, as in the
 * radius rules below. A literal dollar sign must be doubled — but note that the test suite
 * asserts no dollar sign survives substitution, so avoid literals here entirely.
 *
 * Scope is deliberately narrow. The QPalette handles generic widgets, disabled states and
 * dialogs; this file styles only the chrome the palette cannot make distinctive. In
 * particular there is no blanket `QWidget { background: ... }` rule — that leaks into every
 * internal helper widget and sub-control Qt creates.
 *
 * Fonts are set via QApplication.setFont(), not here: Qt stylesheet font properties do not
 * cascade through the widget tree the way CSS does.
 */

QMainWindow,
QDialog {
    background-color: $BG_BASE;
}

/* ---- Menu bar ---------------------------------------------------------------------- */
/* Reachable at all only because the menu bar is in-window; when embedded in the macOS
 * system menu bar, Qt applies no stylesheet to it. */

QMenuBar {
    background-color: $BG_ELEVATED;
    color: $TEXT_SECONDARY;
    border: 0px;
    border-bottom: 1px solid $BORDER;
    padding: 3px 6px;
    spacing: 2px;
}

/* Without an explicit transparent background the item box inherits the bar's colour and
 * hover states render as a flat slab. */
QMenuBar::item {
    background: transparent;
    color: $TEXT_SECONDARY;
    padding: 5px 10px;
    border-radius: ${RADIUS_SM}px;
}

QMenuBar::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

QMenuBar::item:pressed {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}

QMenuBar::item:disabled {
    color: $TEXT_DISABLED;
}

/* ---- Menus ------------------------------------------------------------------------- */

/* The border must be stated explicitly: once QMenu has a stylesheet background, the style
 * stops drawing its own frame. */
QMenu {
    background-color: $BG_OVERLAY;
    border: 1px solid $BORDER_STRONG;
    border-radius: ${RADIUS_MD}px;
    padding: 6px;
}

/* Colours only — deliberately no padding, border-radius or other geometry on ::item.
 *
 * Setting any geometry property here makes Qt lay the item out with the CSS box model, which
 * does not reserve the columns the style normally allocates: the shortcut text ("Cmd+Q") stops
 * being drawn and the check/icon gutter disappears. Measured on this menu: no rules 120px wide,
 * colours only 120px, add padding 79px, add border-radius 25px.
 *
 * So the rounded-pill highlight is given up in exchange for correct menu metrics. The theme's
 * character comes from the menu frame and the accent colour instead; a full-width highlight bar
 * is what native menus use on both platforms anyway. */
QMenu::item {
    background: transparent;
    color: $TEXT_PRIMARY;
}

QMenu::item:selected {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}

QMenu::item:disabled {
    background: transparent;
    color: $TEXT_DISABLED;
}

/* Separators collapse to zero height under a stylesheet unless given one explicitly. */
QMenu::separator {
    height: 1px;
    background-color: $BORDER;
    margin: 6px 10px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 8px;
}

/* ---- Status bar -------------------------------------------------------------------- */

QStatusBar {
    background-color: $BG_ELEVATED;
    border-top: 1px solid $BORDER;
    color: $TEXT_SECONDARY;
}

/* Fusion draws a border around each status bar item otherwise. */
QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: $TEXT_SECONDARY;
}

/* ---- Tooltips ---------------------------------------------------------------------- */

QToolTip {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER_STRONG;
    border-radius: ${RADIUS_SM}px;
    padding: 4px 6px;
}

/* ---- Scrollbars -------------------------------------------------------------------- */
/* Slim and unobtrusive: this is a writing surface, not a dashboard. */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: $BORDER_STRONG;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
}

QScrollBar::handle:hover {
    background-color: $TEXT_DISABLED;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ---- Views ------------------------------------------------------------------------- */
/* Every rule below is scoped to an object name set in a module's view code, so the
 * chrome-only philosophy above still holds: nothing here leaks into generic widgets. */

/* Corkboard: cards as raised, bordered chrome on the base background — fully themed.
 * The panel is a plain QWidget, which only honours a stylesheet background when
 * WA_StyledBackground is set — the view sets it. */
#CorkboardPanel {
    background-color: $BG_BASE;
}

#CorkboardCard {
    background-color: $BG_ELEVATED;
    border: 1px solid $BORDER;
    border-radius: 6px;
}

/* Selection and the keyboard cursor are two levels: every selected card is framed, and
 * the one the arrows move from — always exactly one — takes the accent. */
#CorkboardCard[selected="true"] {
    border: 2px solid $BORDER_STRONG;
}

#CorkboardCard[current="true"] {
    border: 2px solid $ACCENT;
}

/* The empty slot a card leaves behind while its ghost is being dragged. */
#CorkboardCard[dragging="true"] {
    background-color: $BG_BASE;
    border: 1px dashed $BORDER;
}

/* Excluded from export/reader: still editable, visibly set aside. */
#CorkboardCard[excluded="true"] #CardTitle,
#CorkboardCard[excluded="true"] #CardNote {
    color: $TEXT_DISABLED;
}

/* Colours must be stated here, not left to the palette: a widget matched by any
 * stylesheet rule resolves its colours from the stylesheet cascade. */
#CardTitle,
#CardNote {
    background: transparent;
    border: none;
    color: $TEXT_PRIMARY;
    selection-background-color: $SELECTION_BG;
    selection-color: $SELECTION_FG;
}

#CardRule {
    background-color: $BORDER;
}

#CardChildCount {
    color: $TEXT_SECONDARY;
}

/* Section headers: a container as a full-width headline over an edge-to-edge rule. */
#CorkboardSectionTitle {
    color: $TEXT_PRIMARY;
}

#CorkboardSectionChevron, #CorkboardSectionCount {
    color: $TEXT_SECONDARY;
}

#CorkboardSectionRule {
    background-color: $BORDER;
    border: none;
}

#CorkboardSectionHeader[selected="true"] #CorkboardSectionTitle {
    color: $TEXT_PRIMARY;
}

#CorkboardSectionHeader[selected="true"] {
    background-color: $BG_ELEVATED;
}

#CorkboardSectionHeader[current="true"] #CorkboardSectionTitle {
    color: $ACCENT;
}

#CorkboardSectionHeader[drop_target="true"] {
    background-color: $BG_ELEVATED;
}

#CorkboardSectionHeader[excluded="true"] #CorkboardSectionTitle {
    color: $TEXT_DISABLED;
}

#CorkboardInsertionIndicator {
    background-color: $ACCENT;
}

#CorkboardAppearancePopover {
    background-color: $BG_ELEVATED;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
}

/* A panel area (framework/panels.py): the border belongs here rather than to any panel,
   because a panel moves between areas and only the area knows which side faces the tabs. */
#PanelAreaLeft {
    background-color: $BG_ELEVATED;
    border-right: 1px solid $BORDER;
}

#PanelAreaRight {
    background-color: $BG_ELEVATED;
    border-left: 1px solid $BORDER;
}

#PanelAreaBottom {
    background-color: $BG_ELEVATED;
    border-top: 1px solid $BORDER;
}

/* The index tree, whose folders come from whoever registered them. */
#IndexPanel {
    background-color: $BG_ELEVATED;
}

#IndexTree {
    background-color: $BG_ELEVATED;
    border: none;
    color: $TEXT_SECONDARY;
    padding: 8px 4px;
}

/* DESIGN.md's row metrics for a list of rich items: 10 px vertical, 12 px horizontal.
   The horizontal half is split between the tree's own padding and the item's, so a
   nested row still indents rather than starting at the frame. */
#IndexTree::item {
    padding: 5px 8px;
    border-radius: ${RADIUS_SM}px;
}

#IndexTree::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#IndexTree::item:hover {
    color: $TEXT_PRIMARY;
}

#InspectorTabs {
    background: transparent;
}

#InspectorTabs::tab {
    background: transparent;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 2px;
    margin-left: 8px;
    margin-right: 10px;
}

#InspectorTabs::tab:selected {
    color: $TEXT_PRIMARY;
    border-bottom: 2px solid $ACCENT;
}

#InspectorTabs::tab:hover:!selected {
    color: $TEXT_PRIMARY;
}

/* The graph canvas in a project tab. Its nodes and edges are painted by the items
   themselves from the palette (DESIGN.md exception #1), so only the surface comes from
   here — the canvas is the window colour, not a well, because it is the tab's content
   rather than something sitting on it. */
#GraphView {
    background-color: $BG_BASE;
    border: none;
}

/* The order table: steps in the sequence they can be done. A well on the window colour,
   like the step list it replaces, with the row metrics DESIGN.md gives a list of rich
   items. No grid — the alignment is the structure. */
#OrderTable {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
    color: $TEXT_PRIMARY;
}

#OrderTable::item {
    padding: 5px 8px;
}

#OrderTable::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#OrderTable QHeaderView::section {
    background-color: $BG_BASE;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 1px solid $BORDER;
    padding: 6px 8px;
    font-weight: bold;
}

/* The estimate quick-picks: the sizes a step usually is, as one-tap buttons under the day
   box. The quiet bordered look, with the accent only on the one matching the current value —
   DESIGN.md's checked state, and never the surface's primary action. */
#EstimateChip {
    background-color: $BG_OVERLAY;
    color: $TEXT_SECONDARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 4px 8px;
    min-width: 20px;
}

#EstimateChip:hover:!checked {
    color: $TEXT_PRIMARY;
    border-color: $BORDER_STRONG;
}

#EstimateChip:checked {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
}

#EstimateChip:disabled {
    color: $TEXT_DISABLED;
}

/* A prose field inside a detail panel: framed like the panel's other inputs. */
#InspectorNotes {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 4px;
}

/* Read-throughs: completion table tab, its notes field, the status-bar widget. */
#ReadthroughTable {
    background-color: $BG_ELEVATED;
    border: none;
    color: $TEXT_SECONDARY;
}

#ReadthroughTable::item {
    padding: 3px 2px;
    border-radius: ${RADIUS_SM}px;
}

#ReadthroughTable::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#ReadthroughTable::item:hover {
    color: $TEXT_PRIMARY;
}

#ReadthroughNotes, #ReadthroughSectionNotes {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
}

#ReadStatusToggle {
    background-color: $BG_BASE;
    color: $TEXT_SECONDARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 3px 10px;
}

#ReadStatusToggle:hover:!checked {
    color: $TEXT_PRIMARY;
}

#ReadStatusToggle:checked {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
}

/* Status-bar buttons: quiet text that brightens on hover, no button chrome. */
#ReadthroughStatus, #TaskStatusButton {
    background: transparent;
    color: $TEXT_SECONDARY;
    border: none;
    padding: 0 6px;
}

#ReadthroughStatus:hover, #TaskStatusButton:hover {
    color: $TEXT_PRIMARY;
}

/* Binder: the structure tree on the Manuscript sidebar page. */
#BinderPanel {
    background-color: $BG_ELEVATED;
}

#BinderTree {
    background-color: $BG_ELEVATED;
    border: none;
    color: $TEXT_SECONDARY;
}

#BinderTree::item {
    padding: 3px 2px;
    border-radius: ${RADIUS_SM}px;
}

#BinderTree::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#BinderTree::item:hover {
    color: $TEXT_PRIMARY;
}

#BinderSearch {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 4px 6px;
    margin: 6px;
}

#BinderSearch:focus {
    border-color: $ACCENT;
}

#BinderResults {
    background-color: $BG_ELEVATED;
    border: none;
    color: $TEXT_SECONDARY;
}

#BinderResults::item {
    padding: 5px 6px;
    border-bottom: 1px solid $BORDER;
}

#BinderResults::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

/* A detail panel's body, below its frame's header strip. */
#InspectorPanel {
    background-color: $BG_ELEVATED;
}

#InspectorName, #InspectorTitle {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px 8px;
}

#InspectorStats {
    color: $TEXT_SECONDARY;
}

#InspectorCaption {
    color: $TEXT_SECONDARY;
    font-weight: bold;
}

/* A secondary remark under a caption (a notice, a hint): same colour, normal weight —
 * one caption per block. */
#InspectorNote {
    color: $TEXT_SECONDARY;
}

/* Feature cards in the Text tab (framework/cards.py): a well on the elevated panel, the
 * same contrast as the Properties fields above. No colour here — it would cascade onto
 * every label inside. */
#ToolCard {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#ToolCardRule {
    background-color: $BORDER;
}

/* Open Manuscript dialog: tabs need explicit rules (nothing else in the app shows a
 * QTabBar through QSS), buttons share the reader-toolbar look. */
/* Underline-style tabs: text with an accent bar under the active one — chrome that
 * belongs to the theme, not buttons pretending to be tabs. */
#OpenDialogTabs::pane {
    border: none;
    border-top: 1px solid $BORDER;
}

#OpenDialogTabs QTabBar {
    background: transparent;
}

#OpenDialogTabs QTabBar::tab {
    background: transparent;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 2px;
    margin-right: 18px;
}

#OpenDialogTabs QTabBar::tab:selected {
    color: $TEXT_PRIMARY;
    border-bottom: 2px solid $ACCENT;
}

#OpenDialogTabs QTabBar::tab:hover:!selected {
    color: $TEXT_PRIMARY;
}

#OpenDialogTable {
    background-color: $BG_ELEVATED;
    border: none;
}

#OpenDialogTable::item {
    padding: 4px 8px;
    border: none;
}

#OpenDialogTable QHeaderView::section {
    background-color: transparent;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 1px solid $BORDER;
    padding: 4px 8px;
}

#OpenDialogStatus {
    color: $TEXT_SECONDARY;
}

#OpenDialogButton {
    background-color: $BG_OVERLAY;
    color: $TEXT_SECONDARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 5px 10px;
}

#OpenDialogButton:hover {
    color: $TEXT_PRIMARY;
    border-color: $BORDER_STRONG;
}

/* Reader: toolbar buttons and the table of contents (styled like the binder) — the
 * browser is prose and stays unboxed below. The quiet bordered button look is shared
 * with the task browser's in-row Cancel. */
#ReaderToolButton, #ToolbarButton, #TaskRowCancel {
    background-color: $BG_OVERLAY;
    color: $TEXT_SECONDARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 5px 10px;
}

#ReaderToolButton:hover, #ToolbarButton:hover, #TaskRowCancel:hover {
    color: $TEXT_PRIMARY;
    border-color: $BORDER_STRONG;
}

#TaskRowCancel:disabled {
    color: $TEXT_DISABLED;
}

#ToolbarButton {
    /* Glyphs and icons carry different metrics; one fixed height keeps the row even. */
    min-height: 16px;
    max-height: 16px;
}

#ToolbarButton:checked {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
}

#ToolbarLabel {
    color: $TEXT_SECONDARY;
}

#ReaderToc {
    background-color: $BG_ELEVATED;
    border: none;
    border-left: 1px solid $BORDER;
    color: $TEXT_SECONDARY;
}

#ReaderToc::item {
    padding: 3px 2px;
    border-radius: ${RADIUS_SM}px;
}

#ReaderToc::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#ReaderToc::item:hover {
    color: $TEXT_PRIMARY;
}

/* Prose surfaces sit directly on the window colour — no box around the text. The
 * bg_surface colour stays reserved for genuine input wells (search, inspector, notes). */
#ManuscriptEdit,
#SegmentBody,
#ZenEdit,
#ReaderBrowser {
    background-color: $BG_BASE;
    border: none;
}

#ManuscriptEdit,
#SegmentBody,
#ZenEdit {
    padding: 12px 0px 48px 0px;
}

/* Zen mode: the manuscript full screen with one quiet corner line — the progress
 * percentage and a text-only "…" button, both deliberately chrome-free — plus the
 * button's mode popup and the transient bottom notice. */
#ZenWindow {
    background-color: $BG_BASE;
}

#ZenProgress {
    color: $TEXT_DISABLED;
}

#ZenMenuButton {
    background: transparent;
    border: none;
    color: $TEXT_DISABLED;
    padding: 0px 2px;
}

#ZenMenuButton:hover {
    color: $TEXT_PRIMARY;
}

#ZenModePopup {
    background-color: $BG_ELEVATED;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
}

/* A row of quiet text buttons; the checked mode reads in the accent colour. */
#ZenModeButton {
    background: transparent;
    border: none;
    color: $TEXT_SECONDARY;
    padding: 5px 8px;
}

#ZenModeButton:hover {
    color: $TEXT_PRIMARY;
}

#ZenModeButton:checked {
    color: $ACCENT;
}

#ZenPopupRule {
    background-color: $BORDER;
    border: none;
}

#ZenTocList {
    background-color: $BG_ELEVATED;
    border: none;
    color: $TEXT_SECONDARY;
}

#ZenTocList::item {
    padding: 3px 8px;
    border-radius: ${RADIUS_SM}px;
}

#ZenTocList::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#ZenTocList::item:hover {
    color: $TEXT_PRIMARY;
}

#ZenNotice {
    color: $TEXT_SECONDARY;
}

/* The read-only manuscript heading above the segment body; scrolls with the prose.
 * 4px left aligns with the body text, which sits inset by its QTextDocument margin. */
#SegmentEditorTitle {
    color: $TEXT_PRIMARY;
    padding: 12px 0px 0px 4px;
}

#ReaderBrowser {
    padding: 32px 0px 96px 0px;
}

/* ---- Edit review dialog (DESIGN.md: spacious, what/why hierarchy, one accent) ------- */

#EditReviewChangeList {
    background-color: $BG_SURFACE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

/* Prose wells: framed like the inspector's text inputs; breathing room comes from the
 * document margin set in code, not padding, so offsets stay unpadded. */
#EditReviewOriginal, #EditReviewProposed {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#EditReviewProgress, #EditReviewSummary, #EditReviewOptionDescription, #StyleDecisionChoice {
    color: $TEXT_SECONDARY;
}

/* ---- Card preview (Space on the corkboard): a page, not a form ---------------------- */

/* A prose well like the review dialog's panes; the text is inset by the document margin
 * set in code, so no padding here. */
#CardPreviewBody {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#CardPreviewPosition {
    color: $TEXT_SECONDARY;
}

/* Dialog footer buttons: quiet bordered secondaries, at most one accent primary. */
#EditReviewDialog QPushButton, #TaskBrowserDialog QPushButton, #CardPreviewDialog QPushButton {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px 14px;
}

#EditReviewDialog QPushButton:hover,
#TaskBrowserDialog QPushButton:hover,
#CardPreviewDialog QPushButton:hover {
    border-color: $BORDER_STRONG;
}

#EditReviewDialog QPushButton:disabled,
#TaskBrowserDialog QPushButton:disabled,
#CardPreviewDialog QPushButton:disabled {
    color: $TEXT_DISABLED;
}

#EditReviewDialog #PrimaryButton, #CardPreviewDialog #PrimaryButton {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
    font-weight: bold;
    padding: 6px 18px;
}

#EditReviewDialog #PrimaryButton:hover, #CardPreviewDialog #PrimaryButton:hover {
    background-color: $ACCENT_HOVER;
    border-color: $ACCENT_HOVER;
}

#EditReviewDialog #PrimaryButton:disabled {
    background-color: $BG_OVERLAY;
    color: $TEXT_DISABLED;
    border-color: $BORDER;
}

/* The model's advice on one option of a style decision: the caption look (bold secondary),
 * so it reads as a marker without competing with the accent on the chosen option. */
#EditReviewOptionRecommended {
    color: $TEXT_SECONDARY;
    font-weight: bold;
}

/* The chosen option of a style decision: the accent marks the checked state. */
#EditReviewDialog #EditReviewOption:checked {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
    font-weight: bold;
}

/* ---- Task centre (DESIGN.md: what/why rows in a framed well, quiet actions) -------- */

/* The scroll area is the well; rows inside are transparent and separated by hairlines. */
#TaskBrowserWell {
    background-color: $BG_SURFACE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#TaskRow {
    border-bottom: 1px solid $BORDER;
}

#TaskRowStatus, #TaskBrowserEmpty, #TaskBrowserSummary, #TaskRowDismiss {
    color: $TEXT_SECONDARY;
}

#TaskRowDismiss {
    background: transparent;
    border: none;
    padding: 0 4px;
}

#TaskRowDismiss:hover {
    color: $TEXT_PRIMARY;
}

/* A thin accent strip: the chunk must be styled too, or Fusion's striped chunk is drawn
 * into the 4 px trough and reads as mud. */
#TaskBrowserDialog QProgressBar {
    background-color: $BG_OVERLAY;
    border: none;
    border-radius: 2px;
}

#TaskBrowserDialog QProgressBar::chunk {
    background-color: $ACCENT;
    border-radius: 2px;
}
