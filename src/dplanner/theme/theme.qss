/* DPlanner — theme stylesheet (one template, substituted per theme).
 *
 * A string.Template. Placeholders are a dollar sign followed by a token name from
 * dplanner.theme.tokens; use the braced form wherever a letter follows the name, as in the
 * radius rules below. A literal dollar sign must be doubled — but note that the test suite
 * asserts no dollar sign survives substitution, so avoid literals here entirely.
 *
 * Scope is deliberately narrow. The QPalette handles generic widgets, disabled states and
 * dialogs; this file styles only the chrome the palette cannot make distinctive. In
 * particular there is no blanket `QWidget { background: ... }` rule — that leaks into every
 * internal helper widget and sub-control Qt creates.
 *
 * Every object-name rule names something a widget sets: tests/test_theme.py checks each
 * `#Name` against the source, so a rule for a surface that no longer exists fails the
 * suite rather than lingering. A shared primitive names its *parts* (#DialogBody,
 * #DialogFooter, #Table) so that no dialog or table is ever added to a selector list.
 *
 * Fonts are set via QApplication.setFont(), not here: Qt stylesheet font properties do not
 * cascade through the widget tree the way CSS does.
 */

QMainWindow,
QDialog {
    background-color: $BG_BASE;
}

/* ---- Menu bar ---------------------------------------------------------------------- */
/* Reachable at all only because the menu bar is in-window; when embedded in the macOS
 * system menu bar, Qt applies no stylesheet to it. */

QMenuBar {
    background-color: $BG_ELEVATED;
    color: $TEXT_SECONDARY;
    border: 0px;
    border-bottom: 1px solid $BORDER;
    padding: 3px 6px;
    spacing: 2px;
}

/* Without an explicit transparent background the item box inherits the bar's colour and
 * hover states render as a flat slab. */
QMenuBar::item {
    background: transparent;
    color: $TEXT_SECONDARY;
    padding: 5px 10px;
    border-radius: ${RADIUS_SM}px;
}

QMenuBar::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

QMenuBar::item:pressed {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}

QMenuBar::item:disabled {
    color: $TEXT_DISABLED;
}

/* ---- Menus ------------------------------------------------------------------------- */

/* The border must be stated explicitly: once QMenu has a stylesheet background, the style
 * stops drawing its own frame. */
QMenu {
    background-color: $BG_OVERLAY;
    border: 1px solid $BORDER_STRONG;
    border-radius: ${RADIUS_MD}px;
    padding: 6px;
}

/* Colours only — deliberately no padding, border-radius or other geometry on ::item.
 *
 * Setting any geometry property here makes Qt lay the item out with the CSS box model, which
 * does not reserve the columns the style normally allocates: the shortcut text ("Cmd+Q") stops
 * being drawn and the check/icon gutter disappears. Measured on this menu: no rules 120px wide,
 * colours only 120px, add padding 79px, add border-radius 25px.
 *
 * So the rounded-pill highlight is given up in exchange for correct menu metrics. The theme's
 * character comes from the menu frame and the accent colour instead; a full-width highlight bar
 * is what native menus use on both platforms anyway. */
QMenu::item {
    background: transparent;
    color: $TEXT_PRIMARY;
}

QMenu::item:selected {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}

QMenu::item:disabled {
    background: transparent;
    color: $TEXT_DISABLED;
}

/* Separators collapse to zero height under a stylesheet unless given one explicitly. */
QMenu::separator {
    height: 1px;
    background-color: $BORDER;
    margin: 6px 10px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 8px;
}

/* The picker (framework/picker.py): the command palette, and Jump to on the graph. It is
   an overlay a keystroke raises over the window, not a dialog with a question and a way
   out — so it wears the menu's own frame rather than a dialog's, and its field and list
   sit inside it with no ground of their own. */
#Picker {
    background-color: $BG_OVERLAY;
    border: 1px solid $BORDER_STRONG;
    border-radius: ${RADIUS_MD}px;
}

#PickerInput {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: ${CELL_PADDING_V}px ${ROW_PADDING_H}px;
}

#PickerInput:focus {
    border-color: $ACCENT;
}

/* The rows are the delegate's; the list is a hole in the overlay, not a well inside it.
   A picked row is the table's: the accent on its left edge over a quiet ground, never a
   band of colour across it. */
#PickerList {
    background: transparent;
    border: none;
}

#PickerList::item {
    border-left: ${EDGE_W}px solid transparent;
}

#PickerList::item:hover {
    background-color: $BG_ELEVATED;
}

#PickerList::item:selected {
    background-color: $ACCENT_WASH;
    border-left: ${EDGE_W}px solid $ACCENT;
}

/* The Settings tree (modules/settings/dialog.py): the picker list's rules on the dialog's
   own ground — a hole in the page, the row washed under the pointer and wearing the accent
   on its edge when picked, no dotted frame on the current row. A folder is a heading, bold
   and secondary, set in Python: it is never picked. */
#SettingsTree {
    background: transparent;
    border: none;
    color: $TEXT_PRIMARY;
    outline: 0;
}

#SettingsTree::item {
    padding: ${CELL_PADDING_V}px ${CELL_PADDING_H}px;
    border-left: 2px solid transparent;
}

#SettingsTree::item:hover {
    background-color: $BG_ELEVATED;
}

#SettingsTree::item:selected {
    background-color: $ACCENT_WASH;
    border-left: 2px solid $ACCENT;
    color: $TEXT_PRIMARY;
}

/* ---- Status bar -------------------------------------------------------------------- */

QStatusBar {
    background-color: $BG_ELEVATED;
    border-top: 1px solid $BORDER;
    color: $TEXT_SECONDARY;
}

/* Fusion draws a border around each status bar item otherwise. */
QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: $TEXT_SECONDARY;
}

/* ---- Tooltips ---------------------------------------------------------------------- */

QToolTip {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER_STRONG;
    border-radius: ${RADIUS_SM}px;
    padding: 4px 6px;
}

/* ---- Scrollbars -------------------------------------------------------------------- */
/* Slim and unobtrusive: this is a writing surface, not a dashboard. */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: $BORDER_STRONG;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
}

QScrollBar::handle:hover {
    background-color: $TEXT_DISABLED;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ---- Views ------------------------------------------------------------------------- */
/* Every rule below is scoped to an object name set in a module's view code, so the
 * chrome-only philosophy above still holds: nothing here leaks into generic widgets. */

/* A panel area (framework/panels.py): its ground. It draws no edge of its own — the seam
   below already falls there, and two lines a pixel apart is what you get when both draw one. */
#PanelAreaLeft,
#PanelAreaRight,
#PanelAreaBottom {
    background-color: $BG_ELEVATED;
}

/* ---- Seams --------------------------------------------------------------------------- */
/* Two surfaces that meet at a splitter meet at a hairline: a 1 px $BORDER line inside a 7 px
   handle — thin enough to read as a rule, wide enough to grab. One rule for every splitter
   the application builds, present and future.

   The two orientations are built differently because Qt paints them differently. A
   *horizontal* handle honours the box model, so its line is the content box with the ground
   either side as borders. A *vertical* one fills its whole rect with the background and draws
   its borders outside it, so there the line is one border and the rest is left transparent —
   which shows the splitter's own ground. Anything centred in a vertical handle the way the
   horizontal one is comes out a 7 px slab; tests/test_theme.py renders both rather than
   reading them.

   No splitter names a ground of its own. A horizontal seam's 3 px of $BG_BASE beside an
   elevated panel reads as a groove rather than as a mismatch, and one rule with no exceptions
   is worth more than the three pixels. */
QSplitter::handle:horizontal {
    width: 1px;
    background-color: $BORDER;
    border-left: 3px solid $BG_BASE;
    border-right: 3px solid $BG_BASE;
}

QSplitter::handle:vertical {
    height: 6px;
    background-color: transparent;
    border-bottom: 1px solid $BORDER;
}

/* Under the cursor the line thickens and strengthens; while it is dragged it is the accent.
   The handle stays 7 px through all of it, so nothing either side moves as the pointer
   crosses it. Pressed comes last: a handle being dragged is hovered too. */
QSplitter::handle:horizontal:hover {
    width: 3px;
    background-color: $BORDER_STRONG;
    border-left-width: 2px;
    border-right-width: 2px;
}

QSplitter::handle:vertical:hover {
    height: 5px;
    border-bottom: 2px solid $BORDER_STRONG;
}

QSplitter::handle:horizontal:pressed {
    background-color: $ACCENT;
}

QSplitter::handle:vertical:pressed {
    border-bottom-color: $ACCENT;
}

/* The pane you are in, and only while the window is split (framework/tabs.py). Transparent
   otherwise, so the mark costs no layout shift and an unsplit window shows nothing. */
#ActivityPane {
    border-top: 2px solid transparent;
}

#ActivityPane[active="true"] {
    border-top-color: $ACCENT;
}

/* The index tree, whose folders come from whoever registered them. */
#IndexPanel {
    background-color: $BG_ELEVATED;
}

#IndexTree {
    background-color: $BG_ELEVATED;
    border: none;
    color: $TEXT_SECONDARY;
    padding: 8px 4px;
}

/* DESIGN.md's row metrics for a list of rich items: 10 px vertical, 12 px horizontal.
   The horizontal half is split between the tree's own padding and the item's, so a
   nested row still indents rather than starting at the frame. */
#IndexTree::item {
    padding: 5px 8px;
    border-radius: ${RADIUS_SM}px;
}

#IndexTree::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#IndexTree::item:hover {
    color: $TEXT_PRIMARY;
}

/* The Specs tab's list: the index tree's rules, on the tab page's own ground. A source's
   pages nest under it, so it is a tree; the two-line delegate draws the rows. */
#SpecTree {
    background-color: $BG_BASE;
    border: none;
    color: $TEXT_PRIMARY;
}

#SpecTree::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#InspectorTabs {
    background: transparent;
}

#InspectorTabs::tab {
    background: transparent;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 2px;
    margin-left: 8px;
    margin-right: 10px;
}

#InspectorTabs::tab:selected {
    color: $TEXT_PRIMARY;
    border-bottom: 2px solid $ACCENT;
}

#InspectorTabs::tab:hover:!selected {
    color: $TEXT_PRIMARY;
}

/* The graph canvas in a project tab. Its nodes and edges are painted by the items
   themselves from the palette (DESIGN.md exception #1), so only the surface comes from
   here — the canvas is the window colour, not a well, because it is the tab's content
   rather than something sitting on it. */
#GraphView {
    background-color: $BG_BASE;
    border: none;
}

/* The strip of verbs over a drawing or editing surface — the canvas, and the spec editor.
   It sits on the window colour rather than the surface's, so the surface starts where the
   chrome stops, and one hairline says where that is. */
#CanvasToolbar, #EditorToolbar, #AspectBar {
    background-color: $BG_ELEVATED;
    border-bottom: 1px solid $BORDER;
}

/* The map in the canvas's lower-left corner. Chrome floating over the drawing surface, so it
   takes the toolbar's colour rather than a well's — the canvas itself is $BG_BASE, and a
   well of the same colour would be a border with nothing inside it. */
#CanvasMinimap {
    background-color: $BG_ELEVATED;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

/* The debug tabs' tables (LLM Calls, Telemetry): the table's look, since a table of
   quiet lines is a table of quiet lines whatever it lists; the detail well under each is
   a text well. */
#LLMCallsTable, #TelemetryTable {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
    color: $TEXT_PRIMARY;
}

#LLMCallsTable::item, #TelemetryTable::item {
    padding: 4px 8px;
}

#LLMCallsTable::item:selected, #TelemetryTable::item:selected {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
}

#LLMCallsTable QHeaderView::section, #TelemetryTable QHeaderView::section {
    background-color: $BG_BASE;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 1px solid $BORDER;
    padding: 6px 8px;
    font-weight: bold;
}

/* The estimate quick-picks: the sizes a step usually is, as one-tap buttons under the day
   box. The quiet bordered look, with the accent only on the one matching the current value —
   DESIGN.md's checked state, and never the surface's primary action. */
#EstimateChip {
    background-color: $BG_OVERLAY;
    color: $TEXT_SECONDARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 4px 8px;
    min-width: 20px;
}

#EstimateChip:hover:!checked {
    color: $TEXT_PRIMARY;
    border-color: $BORDER_STRONG;
}

#EstimateChip:checked {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
}

#EstimateChip:disabled {
    color: $TEXT_DISABLED;
}

/* A prose field inside a detail panel: framed like the panel's other inputs. */
#InspectorNotes {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 4px;
}

/* The microphone is on for this field: the edge takes the accent, as a checked verb's
   glyph does, and nothing moves. */
#InspectorNotes[dictating="true"] {
    border-color: $ACCENT;
}

/* Status-bar buttons (framework/widgets.py's StatusBarButton): quiet text that brightens
   on hover, no button chrome. */
#StatusBarButton {
    background: transparent;
    color: $TEXT_SECONDARY;
    border: none;
    padding: 0 6px;
}

#StatusBarButton:hover {
    color: $TEXT_PRIMARY;
}

/* A detail panel's body, below its frame's header strip. */
#InspectorPanel {
    background-color: $BG_ELEVATED;
}

/* A panel inside a tab, beside the canvas (project_editor/side_panel.py): a panel area's
   ground and, like one, no edge of its own — the seam beside it is the splitter's. */
#SidePanel {
    background-color: $BG_ELEVATED;
}

/* Standing notices over the window's content (framework/notices.py): the elevated ground
   the panels wear, parted from the tabs by one hairline — the same seam a splitter draws,
   because this is the same kind of edge and two vocabularies for one line is how a surface
   grows its own look. The rows on it carry the colour: each is a band painted in its tone,
   in code, because a semantic tint is a low-alpha constant and not a theme colour. */
#NoticeBar {
    background-color: $BG_ELEVATED;
    border-bottom: 1px solid $BORDER;
}

/* How far a notice's work has come, beside its verb. Full ink where the words beside it are
   secondary: the band says *something is happening* and this is the one number on it. */
#NoticePercent {
    color: $TEXT_PRIMARY;
}

/* A list of rich rows inside a panel: a well on the panel's elevated ground, the same
   contrast a plain field has, so a panel of lists and a panel of fields read alike. The
   rows themselves are the two-line delegate's. */
#PanelList {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

/* Its way out. A panel in the window's dock is hidden from its header's right-click; one
   inside a tab has no such menu, so it carries the verb — flat, because a bordered box in
   a header reads as a second caption. */
#SidePanelClose {
    background: transparent;
    border: none;
    padding: 2px;
}

#SidePanelClose:hover {
    background-color: $BG_OVERLAY;
    border-radius: ${RADIUS_SM}px;
}

#InspectorTitle {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px 8px;
}

#InspectorCaption {
    color: $TEXT_SECONDARY;
    font-weight: bold;
}

/* A secondary remark under a caption (a notice, a hint): same colour, normal weight —
 * one caption per block. */
#InspectorNote {
    color: $TEXT_SECONDARY;
}

/* A status line's words (framework/signalling.py): its glyph carries the tone as an inline
   colour, the words stay secondary. The Updating indicator is not here — it is a turning
   arc painted from the palette at SECONDARY_ALPHA, and a pixmap ignores `color`. */
#StatusLine {
    color: $TEXT_SECONDARY;
}

/* A progress bar is a 4 px accent strip — no text, no frame — and there is one kind of it
   (DESIGN.md's *Signalling*), under the fact that leads it. The chunk must be styled too,
   or Fusion's striped chunk is drawn into the trough and reads as mud. A standing notice is
   the one place that does not use it: there the whole band fills, because a 4 px strip at
   nought is a hairline nobody reads as a meter. */
QProgressBar {
    background-color: $BG_OVERLAY;
    border: none;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar::chunk {
    background-color: $ACCENT;
    border-radius: 2px;
}

/* A feature's card in a panel (framework/cards.py): a well on the elevated panel, the
 * same contrast as a plain field. No colour here — it would cascade onto every label
 * inside. */
#ToolCard {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#ToolCardRule {
    background-color: $BORDER;
}

/* Progression lanes (modules/progression/view.py): a list on a tab page needs its own
 * ground, or its shape is one faint border. Elevated, so the #ToolCard rows inside sit
 * on the surface that well was designed against — see DESIGN.md §Cards. No colour here,
 * for #ToolCard's reason: it would cascade onto every label inside. */
#ProgressionLane {
    background-color: $BG_ELEVATED;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

/* The quiet bordered button: a toolbar verb, the layout picker, a well row's own verbs.
 * DESIGN.md's *Buttons*: everything that is not the one primary looks like this. */
#ToolbarButton, #LayoutButton, #TemplateButton, #PanelButton, #FilterButtonFace,
#FilterButtonClear {
    background-color: $BG_OVERLAY;
    color: $TEXT_SECONDARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px 12px;
}

#ToolbarButton:hover:enabled, #LayoutButton:hover:enabled, #TemplateButton:hover:enabled,
#PanelButton:hover:enabled, #FilterButtonFace:hover:enabled,
#FilterButtonClear:hover:enabled {
    color: $TEXT_PRIMARY;
    border-color: $BORDER_STRONG;
}

/* Off. *Disabled, never hidden* only teaches while a greyed control reads as greyed, and a
   rule that sets `color` takes the palette's disabled ink out of Qt's hands — so every quiet
   button has to say what it looks like off, and its hover must not answer (`:enabled` above).
   The ground goes with the ink: a bordered box in the overlay tone reads as a target. */
#ToolbarButton:disabled, #LayoutButton:disabled, #TemplateButton:disabled,
#PanelButton:disabled, #FilterButtonFace:disabled {
    color: $TEXT_DISABLED;
    background-color: transparent;
    border-color: $BORDER_FAINT;
}

/* The filter control (framework/toolbar.py's FilterButton): the face and its × are one
   shape — the corners between them square, one hairline shared — and while a filter is
   on the face wears a wash of the accent over its ground and the accent on its border,
   the glyph having already said so. */
#FilterButtonFace {
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    padding-left: 6px;  /* The glyph carries its own slot for the dot at its left. */
    padding-right: 10px;
}

#FilterButtonFace::menu-indicator {
    image: none;
    width: 0px;
}

#FilterButtonFace[active="true"] {
    background-color: $ACCENT_WASH;
    color: $TEXT_PRIMARY;
    border-color: $ACCENT;
}

#FilterButtonClear {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-left: none;
    padding: 6px 8px;
}

#FilterButtonClear:disabled {
    color: $TEXT_DISABLED;
}

/* A strip of controls on a tab page (framework/toolbar.py's Toolbar), not application
   chrome: no frame, no ground of its own. */
#ControlBar {
    background: transparent;
    border: none;
    padding: 0px;
    spacing: ${CONTROL_GAP}px;
}

/* A dense strip: glyphs read as one set rather than aimed at one at a time, so they pack.
   The aspect bar seats ten toggles in a dock a third of the window wide, and at the verb
   strip's sides two of them fit before the rest fold into the … menu — which for a row
   that answers "what does this step carry" is the row not answering. A property, not a
   name, because this is a mode the primitive offers and not one surface styled by hand.

*/
#ControlBar[dense="true"] #ToolbarButton {
    padding: 6px ${DENSE_GAP}px;
}

/* **A banded strip's glyph button is a square** — the same 6 px all round a content box the
   glyph's own height, which makes it CONTROL_HEIGHT each way. A tool palette is a grid of
   targets of one size, and a square is also what puts the glyph in the middle of its button
   rather than a few pixels left of centre. The width is derived from the height and the
   padding, never typed.

   Banded and not merely dense, because the two strips want opposite things: a palette wants
   room to aim, and the aspect bar wants ten toggles in a 360 px dock — squaring those costs
   it two of them, which for a row that answers "what does this step carry" is the row not
   answering. `add_group` sets the property. */
#ControlBar[banded="true"] #ToolbarButton {
    padding: 6px;
    min-width: 18px;
    max-width: 18px;
}

/* …except where a dropdown arrow needs its room. Both shorthands above are as specific as
   these (two names and an attribute either way), so these come **after** them on purpose —
   the same ordering the accent primary relies on at the end of the button rules. Without
   them a strip takes the arrow's padding back and Qt paints a 20 px subcontrol straight
   over a 16 px glyph: a styled subcontrol is outside Qt's size hint, nothing widens the
   button, and the only sign is a clipped glyph. */
#ControlBar #ToolbarButton[hasMenu="true"] {
    padding-right: ${ARROW_ROOM}px;
}

#ControlBar #ToolbarButton[face="true"] {
    padding-right: ${INDICATOR_ROOM}px;
}

#ControlBar::separator {
    background-color: $BORDER_FAINT;
    width: 1px;
    margin: 6px 4px;
}

/* A combo box on a strip, or in a dialog's body, is one of the buttons beside it: the
   quiet bordered look, and the arrow's room at the right — Qt's own metric leaves the words
   under the arrow. Styling the drop-down takes Fusion's arrow away, so the arrow is the
   theme's own SVG (theme/__init__.py's drop_arrow_url): a border-drawn triangle flattens
   into a bar at a 2× scale. */
#ControlBar QComboBox, #DialogBody QComboBox {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px ${ARROW_ROOM}px 6px 12px;
    min-height: 18px;
    max-height: 18px;
}

/* The list a combo box drops down: the menu's look — the overlay ground behind a strong
   hairline, rounded, air around every entry, the accent on the one under the pointer. */
QComboBox QAbstractItemView {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER_STRONG;
    border-radius: ${RADIUS_MD}px;
    padding: 6px;
    outline: 0;
    selection-background-color: $ACCENT;
    selection-color: $ON_ACCENT;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: ${RADIUS_SM}px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}

#ControlBar QComboBox:hover, #DialogBody QComboBox:hover {
    border-color: $BORDER_STRONG;
}

#ControlBar QComboBox::drop-down, #DialogBody QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: ${ARROW_W}px;
    border: none;
}

#ControlBar QComboBox::down-arrow, #DialogBody QComboBox::down-arrow {
    image: url($DROP_ARROW);
    width: 10px;
    height: 6px;
}

#ToolbarButton, #PanelButton, #FilterButtonFace, #FilterButtonClear {
    /* Glyphs and words carry different metrics; one content height keeps every control on
       a strip 32 px tall — this, 6 px of padding above and below, and the hairline. */
    min-height: 18px;
    max-height: 18px;
}

/* A divider between a strip's groups: the hairline at half strength, parting without
   drawing attention (framework/toolbar.py's Toolbar; a QToolBar's own separator below). */
#ToolbarDivider {
    background-color: $BORDER_FAINT;
}

#ToolbarButton:checked, #PanelButton:checked {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-color: $ACCENT;
}

/* A styled QToolButton loses Qt's own room for the drop-down arrow: the box model knows
   the text and the padding and nothing about the subcontrol, so the arrow lands on the
   last letter. Both buttons that carry a menu say where it goes and leave room for it —
   and `right` holds it off the border, which right-aligning in the padding box otherwise
   puts it flush against: an arrow a pixel from the edge reads as a clipped button, and on
   a fractionally scaled display that last pixel is the one that goes. */
#ToolbarButton::menu-indicator, #LayoutButton::menu-indicator,
#TemplateButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: ${INDICATOR_W}px;
    right: ${INDICATOR_INSET}px;
}

/* A button whose arrow drops a family down is two targets in one: the front half runs the
   verb, the arrow opens the child menu. Qt sizes that arrow from PM_MenuButtonIndicator —
   about ten pixels, a sliver nobody can aim at and which reads as a rendering fault beside
   the button it is attached to. It gets a real width instead, and the hairline that parts
   it from the button half is what says the two halves do different things. */
#ToolbarButton::menu-button {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: ${ARROW_W}px;
    /* $BORDER_STRONG, not $BORDER, because this one line has to read on two grounds: the
       button's quiet ground, and the accent fill a checked mode button wears. A second rule
       for the checked case is what this file used to have, and a
       `#ToolbarButton:checked::menu-button` rule — in *any* form — makes Qt drop the
       button's own left border, on every toolbar button in the application, checked or
       not. One colour, one rule, no subcontrol pseudo-state. */
    border-left: 1px solid $BORDER_STRONG;
    border-top-right-radius: ${RADIUS_SM}px;
    border-bottom-right-radius: ${RADIUS_SM}px;
}

#ToolbarButton::menu-arrow {
    width: 8px;
    height: 8px;
}

/* And the words step aside for it. A styled subcontrol is outside Qt's size hint, so
   without this the arrow is painted over the last letter — which is what the ten-pixel
   sliver was hiding. ActionToolbar sets the property on the buttons it gives a menu. */
#ToolbarButton[hasMenu="true"] {
    padding-right: ${ARROW_ROOM}px;
}

/* A face that names the current choice and drops the choices down: the layout picker on
   the canvas, the template on the aspect bar, a strip's glyph face standing for a whole
   band of the menus. All three leave the indicator its room — a styled subcontrol is
   outside Qt's size hint, so without this the arrow is painted over the last letter. */
#LayoutButton, #TemplateButton, #ToolbarButton[face="true"] {
    padding-right: ${INDICATOR_ROOM}px;
}

#ToolbarLabel {
    color: $TEXT_SECONDARY;
}

/* The name under a band of a grouped strip (framework/toolbar.py's Toolbar): quiet words
   a point smaller, set in code, saying what the glyphs above them are for. It is chrome
   over a row of controls, never a caption over a block, so it takes no weight. */
#ToolbarGroupLabel {
    color: $TEXT_SECONDARY;
}

/* ---- Installing DPlanner (DESIGN.md: what/why rows in a framed well) --------------- */

/* Three rows, never more, so the well is a plain frame rather than a scroll area. */
#InstallWell {
    background-color: $BG_SURFACE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#InstallRow {
    border-bottom: 1px solid $BORDER;
}

/* The last row has no row below it to be parted from, and the well's own border is
 * already there — two lines a pixel apart is what the seam rule forbids. */
#InstallRow[last="true"] {
    border-bottom: none;
}

/* ---- A well of rows (framework/row_well.py): the task and Agents browsers ----------- */

/* The scroll area is the well; its rows are transparent and parted by hairlines, the last
 * by nothing — the well's own border is already there, and two lines a pixel apart is what
 * the seam rule forbids. A row's second line is a StatusLine and its verbs are the quiet
 * bordered buttons, so neither needs a rule here. */
#RowWell {
    background-color: $BG_SURFACE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

#WellRow {
    border-bottom: 1px solid $BORDER;
}

#WellRow[last="true"] {
    border-bottom: none;
}

#WellRowDismiss {
    background: transparent;
    border: none;
    color: $TEXT_SECONDARY;
    padding: 0 ${DENSE_GAP}px;
}

#WellRowDismiss:hover {
    color: $TEXT_PRIMARY;
}

/* ---- Projects: the Project dialog, Move Plan, Open Project, Share Project (DESIGN.md:
 * settings above a rule, log wells below; a glyph button beside each field; one primary
 * per surface) ---- */

/* A glyph button beside a field: the quiet bordered look, the verb in its tooltip. */
QToolButton[repoTool="true"] {
    background-color: $BG_OVERLAY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 4px;
}

QToolButton[repoTool="true"]:hover {
    border-color: $BORDER_STRONG;
}

/* The wells: a log column, the folder candidates, the GitHub list, the projects to add,
 * and the two ways into Open Project. */
#LogWell, #RepositoriesFolderList, #GhRepoList, #OpenProjectsList, #OpenProjectWays {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
}

/* Secondary text: a column's branch, what an empty page says — and the footer line under
 * a column that names a fact nobody has recorded. Every other remark in these dialogs is
 * a note (#InspectorNote) or a StatusLine, and styled as one. */
#LogBranch, #RepoLocation, #RepoLineMissing, #EmptyStateText {
    color: $TEXT_SECONDARY;
}

/* A missing fact is stated, not left blank — and reads as the placeholder it is. */
#RepoLineMissing {
    font-style: italic;
}

/* Under a repository's column: which repository it is (the thing itself), over where it
 * is on this machine (secondary, above). */
#RepoIdentity {
    color: $TEXT_PRIMARY;
}

/* ---- Tables (framework/table.py) --------------------------------------------------- */

/* A well on the window colour; no grid, the alignment is the structure. The delegate
   paints every pixel of text, glyph, hover and edge itself, so there is no ::item padding
   and no ::item:hover here — Qt's hover is per cell, and a row is what the eye reads. The
   header is the caption look laid on its side, over one hairline. */
#Table {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
    color: $TEXT_PRIMARY;
}

#Table::item:selected {
    background-color: $BG_OVERLAY;
}

#Table QHeaderView::section {
    background-color: $BG_BASE;
    color: $TEXT_SECONDARY;
    border: none;
    border-bottom: 1px solid $BORDER;
    padding: ${CELL_PADDING_V}px ${CELL_PADDING_H}px;
    font-weight: bold;
}

/* A list of two-line rows (framework/list_rows.py's RichList): the table's well and its
   picked row — the delegate paints the accent edge over the quiet ground — for a roster
   that is one column of things. The selection ink stays the text's, not the highlight's. */
#RichList {
    background-color: $BG_BASE;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_MD}px;
    color: $TEXT_PRIMARY;
    selection-color: $TEXT_PRIMARY;
}

#RichList::item:hover {
    background-color: $BG_ELEVATED;
}

#RichList::item:selected {
    background-color: $BG_OVERLAY;
}

/* ---- Dialogs (framework/dialog.py) ------------------------------------------------- */

/* The frame names its parts, and every dialog on it is styled through these names — never
   through its own. The frame prints no title and no lead: a heading inside a dialog repeats
   the title bar and pushes the content down. What a confirmation asks is its content, so it
   is body text and not a remark. The footer's buttons are quiet bordered secondaries, and
   the one primary is the rule at the end. */
#DialogQuestion {
    color: $TEXT_PRIMARY;
}

/* A heading over the body, for the one dialog that opens itself rather than being asked
   for (DialogFrame.set_heading). Colour only: its face is title_font, set in Python, so a
   heading and a card's title step up from the same base by the same amount. */
#DialogHeading {
    color: $TEXT_PRIMARY;
}

/* The footer is a band under the page, edge to edge: the elevated ground under a faint
   hairline, the one place a dialog has a second ground, so the eye finds the way out
   without reading. Background only — a colour here would cascade onto the buttons. */
#DialogFooter {
    background-color: $BG_ELEVATED;
    border-top: 1px solid $BORDER_FAINT;
}

/* A footer's buttons, and a quiet verb in a body (framework/widgets.py's quiet()): the
   property selector is (0,1,1), so it never outranks a rule that names its widget. */
#DialogFooter QPushButton,
QPushButton[quiet="true"] {
    background-color: $BG_OVERLAY;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px 14px;
}

#DialogFooter QPushButton:hover,
QPushButton[quiet="true"]:hover {
    border-color: $BORDER_STRONG;
}

#DialogFooter QPushButton:disabled,
QPushButton[quiet="true"]:disabled {
    color: $TEXT_DISABLED;
}

/* A field in a dialog's body: the panel field's look (#InspectorTitle), with the accent
   saying where the keyboard is. Line and text edits only — a bordered QComboBox has to draw
   its own arrow, and a boxed QSpinBox shows two styles; Fusion paints both from the palette. */
#DialogBody QLineEdit, #DialogBody QPlainTextEdit, #DialogBody QTextEdit {
    background-color: $BG_BASE;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_SM}px;
    padding: 6px 8px;
}

#DialogBody QLineEdit:focus, #DialogBody QPlainTextEdit:focus, #DialogBody QTextEdit:focus {
    border-color: $ACCENT;
}

/* A one-line field stands as tall as the combo box and the glyph button beside it: the
   same 18 px of content, the same padding, the same hairline. A row whose controls
   disagree by a few pixels reads as several rows (DESIGN.md's *Forms*). A minimum and not
   a fixed height, because a field may carry a larger font — the Project dialog's name. */
#DialogBody QLineEdit {
    min-height: 18px;
}

/* An editable combo's own line edit is a field inside a field: the combo draws the frame,
   so the edit inside it draws none, and the accent goes on the combo. */
#DialogBody QComboBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0px;
}

#DialogBody QComboBox:focus {
    border-color: $ACCENT;
}

/* ---- The primary button ------------------------------------------------------------ */

/* One accent primary per surface (DESIGN.md's *Buttons*), wherever it is. Type-prefixed
   and LAST of the button rules on purpose: a descendant rule such as `#Dialog QPushButton`
   outranks a bare `#PrimaryButton` whatever the order, which is how this file once grew a
   list of dialog names; `QPushButton#PrimaryButton` ties it on specificity and wins by
   position. Nothing below this may style a QPushButton. */
QPushButton#PrimaryButton {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border: 1px solid $ACCENT;
    border-radius: ${RADIUS_SM}px;
    font-weight: bold;
    padding: 6px 18px;
}

QPushButton#PrimaryButton:hover {
    background-color: $ACCENT_HOVER;
    border-color: $ACCENT_HOVER;
}

QPushButton#PrimaryButton:disabled {
    background-color: $BG_OVERLAY;
    color: $TEXT_DISABLED;
    border-color: $BORDER;
}
